extends SceneTree

const TEST_SCENE := preload("res://addons/SunshineClouds2/ExampleScene.tscn")
const GeneratedOutputPaths := preload("res://tools/generated_output_paths.gd")
const BASELINE_FILE := "sunshine_arc_baseline.png"
const SETTLED_FILE := "sunshine_arc_after_jump.png"

var _scene: Node
var _camera: Camera3D
var _frame := 0
var _baseline_path := ""
var _settled_path := ""


func _initialize() -> void:
	_baseline_path = GeneratedOutputPaths.smoke_capture_path(BASELINE_FILE)
	_settled_path = GeneratedOutputPaths.smoke_capture_path(SETTLED_FILE)
	_scene = TEST_SCENE.instantiate()
	root.add_child(_scene)
	_camera = _scene.get_node("Camera3D") as Camera3D
	var world_environment := _scene.get_node("WorldEnvironment") as WorldEnvironment
	var clouds := world_environment.compositor.compositor_effects[0]
	clouds.resolution_scale = 0
	clouds.accumulation_decay = 0.52
	clouds.max_step_count = 128.0
	clouds.dither_speed = 18.0
	clouds.blur_power = 1.0


func _process(_delta: float) -> bool:
	_frame += 1
	if _frame == 30:
		_save_frame(_baseline_path)
	elif _frame == 31:
		# Reproduce the large previous/current camera delta generated by the
		# ring's fast-travel and floating-origin paths, then remain stationary.
		_camera.global_position += Vector3(250000.0, 18000.0, 190000.0)
		_camera.rotation += Vector3(0.07, 1.9, 0.0)
	elif _frame == 120:
		_save_frame(_settled_path)
		print("Sunshine Arc smoke test complete: %s | %s" % [_baseline_path, _settled_path])
		quit(0)
	return false


func _save_frame(path: String) -> void:
	var image := root.get_texture().get_image()
	var error := image.save_png(path)
	if error != OK:
		push_error("Sunshine Arc smoke capture failed: %s (%s)" % [path, error])
