    public void AddEdit(SmoothTerrainEditCommand command)
    {
        if(!command.IsValid || _baseline==null || command.Radius>SmoothTerrainEditSnapshot.MaximumStampRadiusMeters || command.Radius>_baseline.AroundLength*.5f || !Enum.IsDefined((SmoothTerrainMaterial)command.Material) || _commands.Exists(c=>c.CommandId==command.CommandId))
            throw new ArgumentException("Invalid smooth terrain edit.",nameof(command));
        // The smooth backend used to allow an excavation to pass beneath the
        // structural shell used by the rest of the ring.  That produced solid
        // density with no agreed streaming/physics policy below it.
        if((double)command.Vertical-command.Radius<StructuralBottomVertical)
            throw new ArgumentOutOfRangeException(nameof(command),"Smooth terrain edits may not cross the structural lower bound.");
        command=command with { Around=RingCoordMath.WrapAround(command.Around,_baseline.AroundLength) };
        ulong previousEditRevision=_editRevision;
        RingLodSurfaceEditSnapshot? previousLodSnapshot=_cachedLodSurfaceEditSnapshot;
        bool appendOrdered=_commands.Count==0
            || command.Sequence>_commands[^1].Sequence
            || (command.Sequence==_commands[^1].Sequence&&command.CommandId>_commands[^1].CommandId);
        _commands.Add(command); _editRevision++; _nextCommandId=Math.Max(_nextCommandId,checked(command.CommandId+1));_nextSequence=Math.Max(_nextSequence,checked(command.Sequence+1));_editSnapshot=new SmoothTerrainEditSnapshot(_commands,_editRevision,_baseline.AroundLength);
        _cachedLodSurfaceEditSnapshot=appendOrdered&&previousLodSnapshot?.Version==previousEditRevision
            ? ProjectAppendedEditToLod(previousLodSnapshot,command)
            : null;
        var affected=new HashSet<SmoothTerrainChunkCoordinate>();
        foreach(var pair in _entries)
            if(StampOverlaps(pair.Key,command)) affected.Add(pair.Key);
        _urgentSnapshots.Clear();
        if(appendOrdered)
        {
            var expectedPrevious=new SmoothTerrainRevision(_baseline.Revision,previousEditRevision);
            foreach(SmoothTerrainChunkCoordinate coordinate in affected)
                if(_entries.TryGetValue(coordinate,out Entry? entry)
                    && entry.TargetSnapshot is SmoothTerrainChunkSnapshot cached
                    && cached.Revision==expectedPrevious)
                    _urgentSnapshots[coordinate]=SmoothTerrainSnapshotCapture.ApplyAppendedEdit(cached,_baseline,command,_editRevision);
        }
        // Cancel only jobs that have not acquired a worker.  Active builds are
        // left to their normal cancellation path; aborting the queued visual
        // tail lets the affected collision mesh take the next free worker.
        // A ready presenter remains attached through an edit.  RefreshDesired
        // replaces it atomically when the new mesh arrives, rather than
        // revealing a proxy underlay (or a hole) while the worker runs.
        foreach(var pair in new List<KeyValuePair<SmoothTerrainChunkCoordinate,Entry>>(_entries))
            if(affected.Count>0 && !affected.Contains(pair.Key) && !pair.Value.Ready && !pair.Value.WorkStarted)
                RemoveEntry(pair.Key,pair.Value);
        _urgentRebuilds.Clear();
        _urgentRebuilds.UnionWith(affected);
        _urgentPatchMasks.Clear();
        foreach(SmoothTerrainChunkCoordinate coordinate in affected)
            _urgentPatchMasks[coordinate]=PatchMaskForStamp(coordinate,command);
        // A single brush may touch several resident parents.  Retain every old
        // representation until the entire revision is available, rather than
        // allowing worker completion order to open a seam between parents.
        _editBatch=affected.Count==0?null:new EditBatch(_editRevision,affected);
        _batchRetained.Clear();_batchRetained.UnionWith(affected);
        RefreshDesired();
    }
