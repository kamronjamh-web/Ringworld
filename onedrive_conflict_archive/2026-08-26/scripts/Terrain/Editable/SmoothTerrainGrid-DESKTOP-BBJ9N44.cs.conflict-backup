        _sourceGrid=source; _workers.Dispose(); _workers=new SemaphoreSlim(Math.Max(1,MaxWorkers),Math.Max(1,MaxWorkers));
        _sourceSampler = source.CreateIndependentTerrainSampler(); if(_sourceSampler==null){GD.PushWarning("SmoothTerrainGrid source could not create terrain sampler.");return;} _baseline = new RingTerrainSmoothBaseline(_sourceSampler,source.GetStructuralBottomGlobalY());
