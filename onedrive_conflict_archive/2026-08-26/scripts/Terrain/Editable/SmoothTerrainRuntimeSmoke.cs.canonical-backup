        var diagnostics=grid.CaptureDiagnostics();int count=0;foreach(var pair in diagnostics)if(pair.Value.Resident&&pair.Value.HasCollision){count++;if(pair.Key!=expected)throw new InvalidOperationException($"unexpected collision {pair.Key}");}if(count!=1)throw new InvalidOperationException($"collision count {count}");
    }
}
