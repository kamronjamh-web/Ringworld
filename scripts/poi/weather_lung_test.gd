extends Node3D
## Standalone test scene for the Weather Lung POI (not part of the ring world). Generated by tools/poi/build_weather_lung.gd -- test.
##
## Keys: 1-6 camera bookmarks (dam crest, basin under the hood, turbine throat, gill close-up, 12 km, 40 km handoff),
## N cycle sun mode Auto/Day/Night, T time scale x1/x10/x60, F freeze phase, [ and ] scrub phase, H toggle dressing,
## C toggle collision debug lines, W toggle the test-only water plane.
##
## Command-line (after `--`):
##   --bookmark=N      start at bookmark N (1-based)
##   --sun=day|night   force the sun mode
##   --warmup=FRAMES   warm-up frames before measuring/capturing (default 60)
##   --measure=FRAMES  average frame time over FRAMES frames, print stats and quit
##   --capture=PATH    save a PNG after warm-up (and quit unless --measure given)
##   --phase=P         freeze the breath phase at P (0..1)

const DETAIL_SCENE := "res://assets/poi/weather_lung/WeatherLungDetail.tscn"
const SUN_AUTO := 0
const SUN_DAY := 1
const SUN_NIGHT := 2
const TIME_SCALES := [1.0, 10.0, 60.0]

@onready var _cam: Camera3D = $FlyCamera
@onready var _sun: DirectionalLight3D = $Sun
@onready var _poi: Node3D = $WeatherLungPOI
@onready var _label: Label = $Hud/Status
@onready var _env: Environment = ($WorldEnvironment as WorldEnvironment).environment

var _detail: Node3D
var _sun_mode := SUN_AUTO
var _time_scale_index := 0
var _dressing_visible := true
var _collision_debug: Node3D

var _bookmark := 1
var _measure_frames := 0
var _warmup_frames := 60
var _capture_path := ""
var _phase_arg := -1.0
var _frame := 0
var _times := PackedFloat64Array()
var _gpu_ms := 0.0
var _cpu_ms := 0.0
var _status_timer := 0.0

func _ready() -> void:
	_parse_args()
	var t0 := Time.get_ticks_usec()
	_detail = (load(DETAIL_SCENE) as PackedScene).instantiate()
	var ok: bool = _poi.call("AttachDetail", _detail)
	print("weather lung test: detail attached=", ok, " in ", (Time.get_ticks_usec() - t0) / 1000.0, " ms")
	_poi.call("BindSunSources", _sun, null, null, null)
	_apply_sun_mode()
	if _phase_arg >= 0.0:
		_poi.call("ScrubTo", _phase_arg)
	RenderingServer.viewport_set_measure_render_time(get_viewport().get_viewport_rid(), true)
	(_cam as Object).call("goto_bookmark", maxi(_bookmark - 1, 0))
	if _capture_path != "" or _measure_frames > 0:
		_label.visible = false

func _parse_args() -> void:
	for a in OS.get_cmdline_user_args():
		if a.begins_with("--bookmark="): _bookmark = int(a.get_slice("=", 1))
		elif a.begins_with("--sun="): _sun_mode = SUN_NIGHT if a.get_slice("=", 1) == "night" else SUN_DAY
		elif a.begins_with("--measure="): _measure_frames = int(a.get_slice("=", 1))
		elif a.begins_with("--warmup="): _warmup_frames = int(a.get_slice("=", 1))
		elif a.begins_with("--capture="): _capture_path = a.get_slice("=", 1)
		elif a.begins_with("--phase="): _phase_arg = float(a.get_slice("=", 1))

func _apply_sun_mode() -> void:
	# The C# SunMode enum is Auto, Day, Night, Manual (0..3).
	_poi.set("SunMode", _sun_mode)
	var night := _sun_mode == SUN_NIGHT
	_sun.light_energy = 0.0 if night else 1.0
	_env.background_energy_multiplier = 0.03 if night else 1.0
	_env.ambient_light_energy = 0.05 if night else 1.0

func _unhandled_key_input(event: InputEvent) -> void:
	if not (event is InputEventKey and event.pressed and not event.echo):
		return
	match (event as InputEventKey).keycode:
		KEY_N:
			_sun_mode = (_sun_mode + 1) % 3
			_apply_sun_mode()
		KEY_T:
			_time_scale_index = (_time_scale_index + 1) % TIME_SCALES.size()
			_poi.set("TimeScale", TIME_SCALES[_time_scale_index])
		KEY_F:
			_poi.set("FreezePhase", not bool(_poi.get("FreezePhase")))
		KEY_BRACKETLEFT:
			_poi.call("ScrubTo", float(_poi.call("GetPhase")) - 0.01)
		KEY_BRACKETRIGHT:
			_poi.call("ScrubTo", float(_poi.call("GetPhase")) + 0.01)
		KEY_H:
			_dressing_visible = not _dressing_visible
			_set_dressing(_detail, _dressing_visible)
		KEY_C:
			_toggle_collision_debug()
		KEY_W:
			var w := $TestWaterPlaceholder as Node3D
			w.visible = not w.visible

func _set_dressing(n: Node, on: bool) -> void:
	if n.name == "Dressing" and n is Node3D:
		(n as Node3D).visible = on
		return
	for c in n.get_children():
		_set_dressing(c, on)

func _toggle_collision_debug() -> void:
	if _collision_debug == null:
		_collision_debug = Node3D.new()
		_collision_debug.name = "CollisionDebug"
		var mat := StandardMaterial3D.new()
		mat.shading_mode = BaseMaterial3D.SHADING_MODE_UNSHADED
		mat.albedo_color = Color(1.0, 0.2, 0.9)
		for body in _detail.get_node("Collision").get_children():
			for cs in body.get_children():
				var shape := (cs as CollisionShape3D).shape
				if shape == null:
					continue
				var mi := MeshInstance3D.new()
				mi.mesh = shape.get_debug_mesh()
				mi.material_override = mat
				mi.transform = (body as Node3D).transform
				_collision_debug.add_child(mi)
		_detail.add_child(_collision_debug)
		return
	_collision_debug.visible = not _collision_debug.visible

func _process(delta: float) -> void:
	_status_timer += delta
	if _status_timer >= 0.25 and _label.visible:
		_status_timer = 0.0
		_label.text = "%s\nsun mode %s  time x%d  dressing %s  water %s\nkeys: 1-6 views  N sun  T time  F freeze  [ ] scrub  H dressing  C collision  W water" % [
			_poi.call("DescribeStatus"), ["Auto", "Day", "Night"][_sun_mode], int(TIME_SCALES[_time_scale_index]),
			"on" if _dressing_visible else "off", "on" if ($TestWaterPlaceholder as Node3D).visible else "off"]
	_frame += 1
	if _measure_frames <= 0 and _capture_path == "":
		return
	if _frame <= _warmup_frames:
		return
	if _measure_frames > 0 and _times.size() < _measure_frames:
		_times.append(delta)
		var vp := get_viewport().get_viewport_rid()
		_gpu_ms += RenderingServer.viewport_get_measured_render_time_gpu(vp)
		_cpu_ms += RenderingServer.viewport_get_measured_render_time_cpu(vp)
		return
	if _capture_path != "":
		var img := get_viewport().get_texture().get_image()
		img.save_png(_capture_path)
		print("captured ", _capture_path)
	if _measure_frames > 0:
		var sum := 0.0
		var worst := 0.0
		for t in _times:
			sum += t
			worst = maxf(worst, t)
		var avg := sum / _times.size()
		print("MEASURE bookmark=", _bookmark, " frames=", _times.size(), " avg_ms=", snappedf(avg * 1000.0, 0.01), " fps=", snappedf(1.0 / avg, 0.1),
			" worst_ms=", snappedf(worst * 1000.0, 0.01), " render_gpu_ms=", snappedf(_gpu_ms / _times.size(), 0.01),
			" render_cpu_ms=", snappedf(_cpu_ms / _times.size(), 0.01),
			" draw_calls=", RenderingServer.get_rendering_info(RenderingServer.RENDERING_INFO_TOTAL_DRAW_CALLS_IN_FRAME),
			" objects=", RenderingServer.get_rendering_info(RenderingServer.RENDERING_INFO_TOTAL_OBJECTS_IN_FRAME),
			" primitives=", RenderingServer.get_rendering_info(RenderingServer.RENDERING_INFO_TOTAL_PRIMITIVES_IN_FRAME))
	get_tree().quit()
