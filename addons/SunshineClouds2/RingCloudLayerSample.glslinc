// RingworldTechDemo extension (S6 WO3b; docs/storm-revamp-s6-cloud-layers-design.md sections 3.2 and 3.3): the volumetric low and mid
// cloud layers of the main Sunshine compute.
//
// Included by SunshineCloudsCompute.glsl after RingCloudLayers.glslinc (binding 29), the layer gradient sampler `layer_heightmask`
// (binding 30) and RingStormProfileSample.glslinc, and BEFORE its //Helpers block: tools/cloud_density_fastpath_gpu_test.gd extracts the
// live sampleScene text and stubs g_layers_on / ring_layers_background, so nothing sampleScene calls may live between //Helpers and it.
//
// The march resolves the primary sample's layer map value once (ring_layers_update: one bilinear fetch of the macro map's array layer
// front + 2, or the exact direct build for probes) into g_layer_low / g_layer_mid = (coverage, base, top, stratiformity), and every light
// and ambient sample of that primary reuses them. sampleScene's background density is the max over the (at most two, overlapping) layers
// containing the sample's altitude; a layer with a cleared weather gate returns before any texture fetch.
//
// Height gradient: layer_heightmask is an 8-row RGBA texture generated by SunshineClouds.gd (_build_layer_gradient): rows 2k / 2k + 1 are
// layer k's convective and stratiform profile, blended by the linear filter at v = (2 * row + 0.5 + stratiformity) / 8.
#ifndef RING_CLOUD_LAYER_SAMPLE_GLSLINC
#define RING_CLOUD_LAYER_SAMPLE_GLSLINC

// On for a camera-independent ray with a published layer table (debug mask bit 64 clears it: the single legacy background band).
bool g_layers_on = false;
vec4 g_layer_low = vec4(0.0);
vec4 g_layer_mid = vec4(0.0);
// High-layer coverage of the resolved column (map.z): the cirrus shell's closed-form sun shadow (ring_layers_sun_above).
float g_layer_high_cov = 0.0;
// Weatherness of the resolved column (map.w): non-storm weather decks (Ns, a front's As) close by it (ring_layer_closure).
float g_layer_weather = 0.0;
// Deck weight of the current primary (ring_layers_deck): 1 for a stratiform, non-storm layer sample, 0 for cumulus and storm cloud.
float g_layer_deck = 0.0;
// Vertical metres one primary step covers (|d altitude / d ray| * maxstep); 0 = no thin-layer overlap weighting (probes, light samples).
float g_layer_extent = 0.0;
// Share of the direct sun the layers above the last light march's primary sample take (1 - g_layer_sun), for the ambient term.
float g_layer_shade = 0.0;
// Direct-sun transmittance through the layers above the last sun march's reach (ring_layers_sun_above); 1 = none.
float g_layer_sun = 1.0;
// The lattice stride the current primary's sun march takes (ring_layers_light_stride; sampleLighting).
float g_layer_light_stride = 1.0;
// The weather patch factor per layer (mix(1, shaped patch noise, patchiness)), evaluated once per primary sample: the patch field spans
// tens of kilometres, so the primary's light and ambient samples reuse it. -1 = not evaluated yet.
vec2 g_layer_patch = vec2(-1.0);

// Sun-march subsampling for primaries that hold layer density only (sampleLighting): every RING_LAYER_LIGHT_STRIDE_NEAR-th step of
// the same lattice, or every RING_LAYER_LIGHT_STRIDE_COARSE-th for stratiform samples (smooth sheets, stratiformity > 0.6) and for
// primaries beyond RING_LAYER_LIGHT_FAR_METERS. The first step (the sample's own self-shadow) is always taken. Storm primaries keep
// the full march (and their own two-step shortcut).
#ifndef RING_LAYER_LIGHT_STRIDE_NEAR
#define RING_LAYER_LIGHT_STRIDE_NEAR 3.0
#endif
#ifndef RING_LAYER_LIGHT_STRIDE_COARSE
#define RING_LAYER_LIGHT_STRIDE_COARSE 4.0
#endif
#ifndef RING_LAYER_LIGHT_FAR_METERS
#define RING_LAYER_LIGHT_FAR_METERS 15000.0
#endif

// The macro map's layer value (low, mid, high coverage, weatherness) at a canonical position: one bilinear fetch of the array layer
// front + 2. A position outside the map has no layers (the build covers the whole march plus light reach, so this only happens past the
// ray's end).
vec4 ring_layers_map_at(vec3 canonical) {
	vec4 map = vec4(0.0, 0.0, 0.0, 0.0);
	float circumference = ringMacroMap.b.z;
	float texel = max(ringMacroMap.a.z, 1.0);
	float dx = canonical.x - ringMacroMap.a.x;
	if (circumference > 1.0) dx -= circumference * floor(dx / circumference);
	vec2 t = vec2(dx, canonical.z - ringMacroMap.a.y) / texel;
	vec2 size = ringMacroMap.b.xy;
	if (t.x >= 0.5 && t.y >= 0.5 && t.x <= size.x - 0.5 && t.y <= size.y - 0.5) {
		map = textureLod(ring_macro_map, vec3(t / vec2(textureSize(ring_macro_map, 0).xy), ringMacroMap.a.w + 2.0), 0.0);
	}
	return map;
}

// Resolves the primary sample's layers from the front macro map (ring_layers_map_at).
void ring_layers_update(vec3 canonical) {
	vec4 map = ring_layers_map_at(canonical);
	g_layer_low = ring_cloud_layer_resolve(0, map);
	g_layer_mid = ring_cloud_layer_resolve(1, map);
	g_layer_weather = map.w;
	g_layer_high_cov = map.z;
	g_layer_patch = vec2(-1.0);
}

// Point-probe variant: the exact position-pure build over the systems in g_ws_mask (the CPU twin), independent of the map.
void ring_layers_update_direct(vec3 canonical) {
	vec4 point = ring_ws_direct_point(canonical, g_ws_mask);
	vec4 map = ring_cloud_layers_point(canonical, g_ws_mask, vec2(genericData.data.cloud_weather_frame.y, genericData.data.cloud_weather_frame.z),
		ring_ws_circumference(), point.x);
	g_layer_low = ring_cloud_layer_resolve(0, map);
	g_layer_mid = ring_cloud_layer_resolve(1, map);
	g_layer_weather = map.w;
	g_layer_high_cov = map.z;
	g_layer_patch = vec2(-1.0);
}

// ---- Layer-owned decks (S6 3.8) ---------------------------------------------------------------------------------------------
// Non-storm weather decks close by weatherness the way the storm lift closes the background under a storm, but to a threshold below
// the lift's 1.05 (RING_LAYER_WEATHER_CLOSE): the large noise against the gradient's bottom ramp still shapes an undulating base and the
// deck keeps its density structure. A closed deck seen from below is opaque within one or two samples and sunless, so its colour is the ambient term: decks
// get an unsaturated ambient occlusion (the raw density just above the sample, darker patches under denser cloud) and a column
// darkening (the closed-form vertical transmittance of the layer cloud above the sample: dark under thick Ns, lighter under thin As).
#ifndef RING_LAYER_WEATHER_CLOSE
#define RING_LAYER_WEATHER_CLOSE 0.97
#endif
#ifndef RING_LAYER_DECK_AO_SCALE
#define RING_LAYER_DECK_AO_SCALE 1.0
#endif
#ifndef RING_LAYER_DECK_DARK_FLOOR
#define RING_LAYER_DECK_DARK_FLOOR 0.35
#endif

// 0..1 closure of a layer `col` = (coverage, base, top, stratiformity): weatherness closes any layer (Ns, a front's As); without
// weather a near-full stratiform sheet (a mature As or Sc deck) closes too, so only thin or partial sheets keep gaps. Needs
// RingWeatherSystems.glslinc (g_ws_storm_owned) included first.
// `ownedLevel` is the primary's owned storm level (ring_ws_eval_owned_storm_level).
float ring_layer_closure(vec4 col, float ownedLevel) {
	float weather = smoothstep(0.25, 0.85, g_layer_weather);
	float sheet = smoothstep(0.75, 0.98, col.x) * smoothstep(0.5, 0.9, col.w);
	// A storm-owned column and the lifted heavy overcast keep the S4 rules exactly (the lift closes them).
	return max(weather, sheet) * (1.0 - g_ws_storm_owned) * (1.0 - smoothstep(0.35, 0.80, ownedLevel));
}

// Once per primary, after ring_layers_update(_direct) and the owned storm level: the two layers' closures ride in the not-yet-evaluated
// patch cache as -1 - closure (no extra per-ray state); ring_layer_density unpacks them.
void ring_layers_set_closure(float ownedLevel) {
	g_layer_patch = vec2(-1.0 - ring_layer_closure(g_layer_low, ownedLevel), -1.0 - ring_layer_closure(g_layer_mid, ownedLevel));
}

// Deck weight of a sample at `altitude`: the stratiformity of the layer that holds it (the denser one where they overlap), ramped.
float ring_layers_deck(float altitude) {
	bool inLow = altitude >= g_layer_low.y && altitude <= g_layer_low.z;
	bool inMid = altitude >= g_layer_mid.y && altitude <= g_layer_mid.z;
	if (!inLow && !inMid) return 0.0;
	float stratiformity = inLow && (!inMid || g_layer_low.x >= g_layer_mid.x) ? g_layer_low.w : g_layer_mid.w;
	return smoothstep(0.45, 0.85, stratiformity);
}

// Ambient factor of a deck sample from the vertical transmittance of the layer cloud above it (its own layer's remainder plus the layers
// above, coverage-weighted, at each layer's extinction): RING_LAYER_DECK_DARK_FLOOR under an opaque column, 1 under none.
float ring_layers_column_light(float altitude) {
	float tau = 0.0;
	if (altitude <= g_layer_low.z && g_layer_low.z > g_layer_low.y + 1.0)
		tau += clamp(g_layer_low.x, 0.0, 1.0) * ringCloudLayers.layers[2].w * (g_layer_low.z - max(altitude, g_layer_low.y));
	if (altitude <= g_layer_mid.z && g_layer_mid.z > g_layer_mid.y + 1.0)
		tau += clamp(g_layer_mid.x, 0.0, 1.0) * ringCloudLayers.layers[6].w * (g_layer_mid.z - max(altitude, g_layer_mid.y));
	return mix(RING_LAYER_DECK_DARK_FLOOR, 1.0, exp(-tau));
}

// Deck patches: brighter under thinner cloud just above the sample, darker under denser (aboveDensity: the raw density one minstep up,
// from the primary's ambient-occlusion sample). +-RING_LAYER_DECK_PATCH around 1.
#ifndef RING_LAYER_DECK_PATCH
#define RING_LAYER_DECK_PATCH 0.45
#endif
float ring_layers_deck_patch(float aboveDensity) {
	return 1.0 + RING_LAYER_DECK_PATCH * (1.0 - 2.0 * smoothstep(0.15, 0.85, aboveDensity));
}

// Deck colour (S6 3.8). Under cloud the downwelling light is the sun and sky light the cloud above has scattered, and droplet scattering
// is spectrally flat, so it is near neutral; only gaps and thin spots let the blue sky through. The share of a sample's ambient that comes
// through cloud is its overhead cloud fraction: a closed layer at or above it (closure x coverage; closure is 0 for fair and storm-owned
// columns) or, for a deck sample (deckWeight, ring_layers_deck), the cloud just above it (aboveDensity, the primary's ambient-occlusion
// sample, on the patch ramp), whichever is larger. The march blends the ambient's chroma toward the sun + sky irradiance by it
// (SunshineCloudsCompute.glsl, after the deck column light).
// The closure a layer's patch cache holds (ring_layers_set_closure; packed with the patch factor once ring_layer_density ran).
float ring_layer_cached_closure(int layer) {
	float packed = g_layer_patch[layer];
	return packed < 0.0 ? -1.0 - packed : floor(packed * 0.125) / 31.0;
}
float ring_layers_deck_overcast(float altitude, float aboveDensity, float deckWeight) {
	float overcast = deckWeight * smoothstep(0.15, 0.85, aboveDensity);
	if (altitude <= g_layer_low.z && g_layer_low.z > g_layer_low.y + 1.0)
		overcast = max(overcast, ring_layer_cached_closure(0) * clamp(g_layer_low.x, 0.0, 1.0));
	if (altitude <= g_layer_mid.z && g_layer_mid.z > g_layer_mid.y + 1.0)
		overcast = max(overcast, ring_layer_cached_closure(1) * clamp(g_layer_mid.x, 0.0, 1.0));
	return overcast;
}

// The sun-march stride for a primary at `altitude`, `distance` metres along the view ray: 1 unless it holds layer density only.
float ring_layers_light_stride(bool layerOnly, float altitude, float distance) {
	if (!layerOnly) return 1.0;
	bool inLow = altitude >= g_layer_low.y && altitude <= g_layer_low.z;
	float stratiformity = inLow && (altitude < g_layer_mid.y || g_layer_low.x >= g_layer_mid.x) ? g_layer_low.w : g_layer_mid.w;
	return (stratiformity > 0.6 || distance > RING_LAYER_LIGHT_FAR_METERS) ? RING_LAYER_LIGHT_STRIDE_COARSE : RING_LAYER_LIGHT_STRIDE_NEAR;
}

// True when the altitude lies inside the low or the mid layer of the resolved column.
bool ring_layers_contain(float altitude) {
	return (altitude >= g_layer_low.y && altitude <= g_layer_low.z) || (altitude >= g_layer_mid.y && altitude <= g_layer_mid.z);
}

// The band the light march normalises a sample's height in: (base, top, 1) of the layer containing the altitude (the one with the larger
// coverage where they overlap), or z = 0 outside both.
vec3 ring_layers_light_band(float altitude) {
	bool inLow = altitude >= g_layer_low.y && altitude <= g_layer_low.z;
	bool inMid = altitude >= g_layer_mid.y && altitude <= g_layer_mid.z;
	if (inLow && (!inMid || g_layer_low.x >= g_layer_mid.x)) return vec3(g_layer_low.y, g_layer_low.z, 1.0);
	if (inMid) return vec3(g_layer_mid.y, g_layer_mid.z, 1.0);
	return vec3(0.0);
}

// Direct-sun transmittance through the mid layer above a low-layer primary sample (S6 3.3 inter-layer sun shadowing), multiplied into
// the caller's Beer term. It must be a transmittance: added to the march density (as stormTau is) it gets scaled by the phase
// function (about 0.01) inside Beer and shadowed nothing, which left the low layer's top lit under a closed mid deck (a bright line
// edge-on). Only the part of the layer above the march's own altitude reach counts. Partial cover lets a (1 - coverage) share of the
// sun through: T = 1 - cov * (1 - exp(-k * thickness / sun_up)). sunElevation is the sine of the sun's elevation at the sample.
// A primary inside or above the mid layer's base gets 1 (the march covers it).
// Deck samples (g_layer_deck, S6 3.8) also count the rest of their OWN layer above the march's reach: the march covers only about
// LightingTravelKm of a deck several km thick, so without it the base of a closed Ns deck still saw the sun (a bright glow around it).
// Samples below the High layer's cirrus shell (S6 WO5, render mode 1) also start from its weak closed-form shadow, shadow weight * high
// coverage: the same term the ground takes (SunshineCloudShadowCompute), so the shell darkens the layers below as it darkens the ground.
float ring_layers_sun_above(float altitude, float sunElevation, float reachMeters) {
	float sunUp = max(sunElevation, 0.05);
	float reachTop = altitude + reachMeters * sunUp;
	float transmittance = altitude < ringCloudLayers.layers[8].x && ringCloudLayers.layers[11].w > 0.5 && (ring_ws_debug() & 128) == 0
		? 1.0 - ringCloudLayers.layers[11].z * clamp(g_layer_high_cov, 0.0, 1.0) * (1.0 - g_ws_storm_owned) : 1.0;
	if (g_layer_deck > 0.0) {
		if (altitude >= g_layer_low.y && altitude <= g_layer_low.z)
			transmittance *= 1.0 - g_layer_deck * clamp(g_layer_low.x, 0.0, 1.0)
				* (1.0 - exp(-ringCloudLayers.layers[2].w * max(g_layer_low.z - reachTop, 0.0) / sunUp));
		if (altitude >= g_layer_mid.y && altitude <= g_layer_mid.z)
			transmittance *= 1.0 - g_layer_deck * clamp(g_layer_mid.x, 0.0, 1.0)
				* (1.0 - exp(-ringCloudLayers.layers[6].w * max(g_layer_mid.z - reachTop, 0.0) / sunUp));
	}
	if (altitude >= g_layer_mid.y || g_layer_mid.z <= g_layer_mid.y + 1.0) return transmittance;
	float bottom = max(g_layer_mid.y, reachTop);
	float thickness = max(g_layer_mid.z - bottom, 0.0);
	return transmittance * (1.0 - clamp(g_layer_mid.x, 0.0, 1.0) * (1.0 - exp(-ringCloudLayers.layers[6].w * thickness / sunUp)));
}

// Background density of one layer (0 low, 1 mid) at a sample. `col` is the layer's resolved (coverage, base, top, stratiformity).
float ring_layer_density(int layer, vec4 col, vec3 canonical, float weatherStorm, float extralargeNoiseValue,
	vec3 largeNoisePos, vec3 mediumNoisePos, vec3 smallNoisePos, float largenoisescale, float mediumnoisescale, float smallnoisescale,
	float smallscalePower, float curlPower, float lod, bool ambientsample, bool coarseSunLighting) {
	float thickness = col.z - col.y;
	if (thickness < 1.0 || canonical.y < col.y || canonical.y > col.z) return 0.0;
	vec4 layerA = ringCloudLayers.layers[layer * 4];
	vec4 layerC = ringCloudLayers.layers[layer * 4 + 2];
	vec3 offset = ringCloudLayers.noise[layer].xyz;
	float stratiformity = col.w;
	// The weather gate is pure ALU on the sample's position: a cleared gate skips every fetch below (the single-band path paid two first).
	vec4 weatherParams = genericData.data.cloud_weather_params;
	float patchFactor = g_layer_patch[layer];
	if (patchFactor < 0.0) {
		// ring_cloud_weather_resolved_coverage's patch term (position only), cached for the primary's samples.
		float closureFloor = -1.0 - patchFactor;
		patchFactor = 1.0;
		if (weatherParams.y > 0.0) {
			float field = ring_cloud_weather_noise(canonical + offset, weatherParams, genericData.data.cloud_weather_frame);
			patchFactor = mix(1.0, mix(0.05, 2.0, smoothstep(0.20, 0.80, field)), clamp(weatherParams.x, 0.0, 1.0));
		}
		// Deck closure (S6 3.8): a closed deck's patches cannot thin it below its own coverage. Packed with the factor (factor < 8).
		patchFactor = max(patchFactor, closureFloor) + 8.0 * floor(closureFloor * 31.0 + 0.5);
		g_layer_patch[layer] = patchFactor;
	}
	float closurePacked = floor(patchFactor * 0.125);
	patchFactor -= 8.0 * closurePacked;
	float resolved = clamp(max(clamp(col.x + ringWeatherSystems.header0.w, 0.0, 1.0) * patchFactor, weatherStorm), 0.0, 1.0);
	float gate = ring_cloud_weather_clear_gate(resolved, weatherStorm, weatherParams);
	if (gate <= 0.0) return 0.0;
	// The closure also floors the threshold just below the storm lift, so a closed deck has no holes but keeps an undulating base.
	float threshold = max(mix(mix(0.70, 0.90, resolved), 1.05, smoothstep(0.35, 0.80, weatherStorm)),
		RING_LAYER_WEATHER_CLOSE * (closurePacked / 31.0) * clamp(col.x, 0.0, 1.0));

	float height = (canonical.y - col.y) / thickness;
	float edgeFade = min(smoothstep(0.0, 0.1, height), smoothstep(1.0, 0.9, height));
	// Thin-layer weighting (primary samples only): the share of the step's altitude range that overlaps the layer, so a sheet thinner than
	// the step does not alias into terraces. Normalised by min(range, thickness): a sample inside a thin layer keeps full weight.
	float overlap = 1.0;
	if (!ambientsample && g_layer_extent > 1.0) {
		float low = max(canonical.y - 0.5 * g_layer_extent, col.y);
		float high = min(canonical.y + 0.5 * g_layer_extent, col.z);
		overlap = clamp((high - low) / min(g_layer_extent, thickness), 0.0, 1.0);
	}
	if (edgeFade * overlap <= 0.0) return 0.0;
	float gradientV = (2.0 * layerA.w + 0.5 + stratiformity) / 8.0;
	vec4 gradientSample = texture(layer_heightmask, vec2(height, gradientV));

	float extraLarge = extralargeNoiseValue;
	if (abs(offset.x) + abs(offset.z) > 0.5) {
		extraLarge = texture(extra_large_noise, (canonical.xz + offset.xz - genericData.data.extralargenoiseposition.xz)
			/ genericData.data.extralargenoisescale).a;
	}
	float extraLargeShape = extraLarge * gradientSample.b;

	vec3 position = canonical;
	vec2 windDirection = genericData.data.WindDirection;
	float windSwept = 1.0 - clamp(height / genericData.data.windSweptRange, 0.0, 1.0);
	position += vec3(windDirection.x, 0.0, windDirection.y) * genericData.data.windSweptPower * windSwept * windSwept;

	float effectorAdditive = 0.0;
	if (lod > 0.0) {
		for (int i = 0; i < int(genericData.data.pointEffectorCount); i++) {
			float effectorDistance = distance(pointEffectors[i].position, position);
			if (effectorDistance < pointEffectors[i].radius) effectorAdditive += mix(pointEffectors[i].power, 0.0, effectorDistance / pointEffectors[i].radius);
		}
		effectorAdditive *= edgeFade;
		float curlHeightSample = 1.0 - gradientSample.a;
		if (!ambientsample && curlHeightSample > 0.0 && min(curlPower, lod) > 0.5) {
			float curlLod = (lod - 0.5) / 0.5;
			for (int pass = 0; pass < 3; pass++) {
				position += (((texture(curl_noise, (position + offset - mediumNoisePos) / mediumnoisescale).xyz * 2.0) - 1.0) * vec3(1.0, 0.2, 1.0)
					+ vec3(windDirection.x, 0.0, windDirection.y) * 0.9) * curlPower * curlHeightSample * curlLod;
			}
			gradientSample = texture(layer_heightmask, vec2((position.y - col.y) / thickness, gradientV));
		}
	}

	// Stratiform stretch: the convective lookup and one at the layer's constant horizontal stretch, cross-faded by stratiformity after the
	// threshold (each end is exactly one lookup). Never divide the coordinate by a stratiformity-dependent factor: the coordinate is hundreds of
	// noise periods from the noise origin on the ring, so a spatially varying divisor compresses the noise along stratiformity gradients
	// into thin streaks (the shredded fair-weather sky).
	vec3 largePosition = (position + offset - largeNoisePos) / largenoisescale;
	float largeScale = extraLargeShape * gradientSample.r;
	float largeShape = 0.0;
	if (stratiformity < 1.0)
		largeShape = smoothstep(1.0 - threshold, 1.1 - threshold, texture(large_noise, largePosition).r * largeScale);
	if (stratiformity > 0.0) {
		vec3 stretchedPosition = vec3(largePosition.x / layerC.x, largePosition.y, largePosition.z / layerC.x);
		largeShape = mix(largeShape, smoothstep(1.0 - threshold, 1.1 - threshold, texture(large_noise, stretchedPosition).r * largeScale),
			stratiformity);
	}
	largeShape += max(effectorAdditive, 0.0);
	if (largeShape <= 0.0) return 0.0;
	float mediumshape = 1.0 - texture(noise_medium, (position + offset - mediumNoisePos) / mediumnoisescale).b;
	// Only directional sun transmittance may omit fine erosion (as in the single-band path); stratiform layers erode less.
	float smallRaw = coarseSunLighting ? 0.0 : texture(noise_small, (canonical + offset - smallNoisePos) / smallnoisescale).r;
	float smallShape = smallRaw * gradientSample.g * mix(layerC.y, layerC.z, stratiformity) * pow(1.0 - mediumshape, smallscalePower);
	float shape = mediumshape + max(effectorAdditive, 0.0);
	shape = clamp((shape - (1.0 - largeShape)) / largeShape, 0.0, 1.0);
	shape = clamp((shape - smallShape) / (1.0 - smallShape), 0.0, 1.0);
	shape += min(effectorAdditive, 0.0);
	return clamp(shape * edgeFade, 0.0, 1.0) * gate * overlap;
}

// Background density at a sample: the max over the layers whose altitude range contains it.
float ring_layers_background(vec3 canonical, float weatherStorm, float extralargeNoiseValue,
	vec3 largeNoisePos, vec3 mediumNoisePos, vec3 smallNoisePos, float largenoisescale, float mediumnoisescale, float smallnoisescale,
	float smallscalePower, float curlPower, float lod, bool ambientsample, bool coarseSunLighting) {
	float density = 0.0;
	[[dont_unroll]] for (int layer = 0; layer < 2; layer++) {
		vec4 col = layer == 0 ? g_layer_low : g_layer_mid;
		if (canonical.y < col.y || canonical.y > col.z) continue;
		density = max(density, ring_layer_density(layer, col, canonical, weatherStorm, extralargeNoiseValue,
			largeNoisePos, mediumNoisePos, smallNoisePos, largenoisescale, mediumnoisescale, smallnoisescale,
			smallscalePower, curlPower, lod, ambientsample, coarseSunLighting));
	}
	return density;
}

#endif
